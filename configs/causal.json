/*
 * Full fine-tuning on plain SST-2 sentences; sentiment labels are ignored.
 * Every next token and EOS are targets, unlike response-only SFT.
 * Model: modules.causal; dataset: datasets.causal.
 */
{
  "model_id": "Qwen/Qwen3.5-0.8B",
  "dataset": {
    "id": "stanfordnlp/sst2",
    "train_size": 128,
    "val_size": 32,
    "test_size": 32,
    "train_split": "train",
    "validation_split": "validation",
    "text_column": "sentence"
  },
  "fine_tuning": {
    "mode": "full"
  },
  "learning_rate": 5e-05,
  "batch_size": 1,
  "epochs": 3,
  "device": "cuda",
  "precision": "bfloat16",
  "run_name": "qwen-causal",
  "checkpoints": {"backend": "local", "policy": "default", "overwrite": true},
  "wandb": {"enabled": false, "mode": "offline"}
}
