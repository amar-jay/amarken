{
  "format_version": 1,
  "experiment_id": "training-cpu-smoke-v1",
	"description": "Smoke test for training on CPU with small model and dataset.",
  "seed": 2026,
  "device": "cpu",
  "precision": "fp32",
  "tokenizer": "artifacts/tokenizers/v3/tiktoken-tr-bpe-12k.json",
  "train_data": "data/processed/synthetic/pretraining/shards",
  "train_split": "train",
  "validation_data": "data/processed/synthetic/pretraining/shards",
  "validation_split": "validation",
  "train_token_budget": 128,
  "validation_token_budget": 128,
  "sequence_length": 16,
  "batch_size": 1,
  "gradient_accumulation_steps": 1,
  "optimizer_updates": 2,
  "learning_rate": 0.001,
  "lr_schedule": "cosine",
  "warmup_steps": 0,
