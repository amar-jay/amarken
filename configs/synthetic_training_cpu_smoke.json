      "head_dim": 8,
      "max_position_embeddings": 16
    },
    "bit": {
      "vocab_size": 12000,
      "hidden_size": 16,
      "intermediate_size": 32,
      "num_hidden_layers": 1,
      "num_attention_heads": 2,
      "num_key_value_heads": 1,
      "head_dim": 8,
      "max_position_embeddings": 16
    },
    "glimmer": {
      "vocab_size": 12000,
      "hidden_size": 16,
      "intermediate_size": 32,
      "num_hidden_layers": 1,
      "num_attention_heads": 2,
      "num_key_value_heads": 1,
      "head_dim": 8,
      "max_position_embeddings": 16,
      "sliding_window": 16
    }
  }
}
