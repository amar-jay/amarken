{
  "model_id": "synthetic-mlp",
  "seed": 42,
  "learning_rate": 0.01,
  "batch_size": 16,
  "epochs": 3,
  "device": "cpu",
  "precision": "float32",
  "run_name": "synthetic-example",
  "wandb_enabled": false,
  "wandb_mode": "online",
  "checkpoints": {
    "backend": "local",
    "policy": "default",
    "async_save": true,
    "max_pending": 2,
    "every_n_epochs": 1,
    "monitor": "val/loss",
    "mode": "min"
  }
}
