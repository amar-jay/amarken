{
  "model_id": "synthetic-mlp",
  "seed": 42,
  "learning_rate": 0.01,
  "train_size": 128,
  "val_size": 32,
  "batch_size": 16,
  "epochs": 3,
  "device": "cpu",
  "precision": "float32",
  "run_name": "synthetic-example",
  "checkpoints": {
    "backend": "local",
    "policy": "default",
    "async_save": true,
    "max_pending": 2,
    "monitor": "val/loss",
    "mode": "min",
    "overwrite": true
  },
  "wandb": {
    "enabled": false,
    "mode": "online"
  }
}
