/*
 * Small MLP on synthetic numeric features; no downloads.
 * Model: modules.example; dataset: datasets.example.
 */
{
  "model_id": "synthetic-mlp",
  "dataset": {
    "id": "synthetic",
    "train_size": 128,
    "val_size": 32,
    "test_size": 32,
    "config": null,
    "test_fraction": 0.5
  },
  "seed": 42,
  "learning_rate": 0.01,
  "batch_size": 16,
  "epochs": 3,
  "device": "cpu",
  "strategy": "fsdp2", // Just meant for testing.
  "precision": "float32",
  "run_name": "synthetic-example",
  "checkpoints": {
    "backend": "local",
    "policy": "default",
    "async_save": true,
    "max_pending": 2,
    "monitor": "val/loss",
    "mode": "min",
    "overwrite": false
  },
  "wandb": {
    "enabled": false,
    "mode": "online"
  }
}
