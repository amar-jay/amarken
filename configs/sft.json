/*
 * LoRA SFT; only response tokens and pretrained EOS contribute to loss.
 * Alpaca: modules.causal + datasets.sft (active below).
 * Arithmetic RL warm-up: modules.arithmetic + datasets.arithmetic.
 * For arithmetic, replace the active dataset and run_name with their commented
 * alternatives below. Keep the model and LoRA settings aligned with rl.json.
 */
{
  "model_id": "Qwen/Qwen2.5-0.5B",
  "dataset": {
    "id": "tatsu-lab/alpaca",
    "train_size": 1024,
    "val_size": 128,
    "test_size": 128,
    "train_split": "train",
    "validation_split": "train",
    "text_column": "instruction",
    "label_column": "output",
    "input_column": "input"
  },
  // Arithmetic alternative: comment out the Alpaca dataset above and uncomment:
  // "dataset": {
  //   "id": "arithmetic",
  //   "train_size": 2048,
  //   "val_size": 32,
  //   "test_size": 32
  // },
  "fine_tuning": {
    "mode": "lora",
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "v_proj"
    ]
  },
  "learning_rate": 5e-05,
  "batch_size": 1,
  "epochs": 2,
  "device": "cuda",
  "precision": "bfloat16",
  "run_name": "qwen-sft",
  // Arithmetic alternative: replace the active run_name above with:
  // "run_name": "qwen-arithmetic-sft",
  "checkpoints": {"backend": "local", "policy": "default", "overwrite": true},
  "wandb": {"enabled": false, "mode": "offline"}
}
