/*
 * SST-2 sentiment classification; trains a head on a frozen Qwen backbone.
 * Model: modules.classification; dataset: datasets.classification.
 */
{
  "model_id": "Qwen/Qwen3.5-0.8B",
  "dataset": {
    "id": "stanfordnlp/sst2",
    "train_size": 1280,
    "val_size": 320,
    "test_size": 320,
    "config": null,
    "test_fraction": 0.5,
    "train_split": "train",
    "validation_split": "validation",
    "text_column": "sentence",
    "label_column": "label"
  },
  "seed": 42,
  "learning_rate": 0.01,
  "batch_size": 1,
  "epochs": 3,
  "device": "cuda",
  "strategy": "auto",
  "precision": "bfloat16",
  "run_name": "qwen-classifier",
  "checkpoints": {
    "backend": "local",
    "policy": "default",
    "async_save": true,
    "max_pending": 2,
    "monitor": "val/loss",
    "mode": "min",
    "overwrite": true
  },
  "wandb": {
    "enabled": false,
    "mode": "online"
  }
}
